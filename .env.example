DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ove_wallet_dev
REDIS_URL=redis://localhost:6379

APP_URL=http://localhost:3000
API_URL=http://localhost:4000
ADMIN_URL=http://localhost:3100

SESSION_SECRET=
COOKIE_DOMAIN=localhost

LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_LIFF_ID=
LINE_CALLBACK_URL=

# LINE Messaging API (お知らせのLINE配信連携、docs/credit-expiry.mdと同じ隣接ドキュメント
# パターンで docs/notices-line-broadcast.md 参照)。未設定時はLINEへの配信をスキップする
# (SENTRY_DSN未設定時のno-opと同じ方針)。LINE Login用のLINE_CHANNEL_IDとは別チャネル
# (Messaging APIチャネル) のチャネルアクセストークンを設定する。
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=

# apps/user-wallet (ビルド時にクライアントへ埋め込まれる、Next.jsのNEXT_PUBLIC_規約)。
# 未設定の場合はLIFFを一切呼ばず、疑似ID直接送信のモックログインのままになる
# (apps/api側のAUTH_MODE=mockと対になるフロントエンド側の切り替え、
# apps/user-wallet/src/lib/liff.ts参照)。
NEXT_PUBLIC_LINE_LIFF_ID=

EMAIL_FROM=
EMAIL_PROVIDER=
EMAIL_API_KEY=

SENGOKU_SSO_CLIENT_ID=
SENGOKU_SSO_CLIENT_SECRET=
SENGOKU_SSO_EXCHANGE_URL=

ENCRYPTION_KEY=
AUDIT_LOG_RETENTION_DAYS=365

# エラートラッキング (Sentry, `docs/monitoring.md`)。未設定の場合は何も送信しない
# (アプリの動作自体には影響しない)。
SENTRY_DSN=

# 代理店紹介トークン受け入れ (実装指示書 v1.0): /invite/{token} で発行する紹介セッション
# Cookieの有効期限(時間)と、初回登録特典の額(OVE)。ENABLE_WALLET_REFERRAL_TOKEN=trueで
# 有効化するまでは/invite/{token}にアクセスしてもトークンは保存されない。
REFERRAL_SESSION_TTL_HOURS=24
REFERRAL_SIGNUP_BONUS_AMOUNT=3000

# 二段階承認 (指示書13章): この金額(OVE)以上の個別付与・個別減算は即時実行されず、
# 別の管理者による承認が必要になる (packages側の実装は@ove/apiが直接process.envを読む)
HIGH_VALUE_THRESHOLD=50000

# 代理店システム内共通顧客HUBへの送信 (外部開発者向け連携ガイド9章)。
# ENABLE_PLATFORM_USER_ID=true かつ 送信先URL・system_key・APIキーの設定時のみ、
# 新規アカウント登録時に POST /api/common-users/resolve を呼び出しcommon_user_idを
# 解決・保存する (ベストエフォート、失敗しても登録処理はブロックしない)。
# 送信先URL・system_key・APIキー(代理店システムが発行する「AI受信用APIキー」、
# ガイド3.1章)は環境変数ではなく管理画面 (/common-user-hub-config、
# AdminCommonUserHubService) からDB(common_user_hub_config、暗号化保存)へ設定する。

# 開発ガイドライン12.2章: NODE_ENV=production では AUTH_MODE=production の明示指定が
# 必須 (LINE/戦国パスポートSSOの本番実装が接続されるまでは production を設定しないこと)
AUTH_MODE=mock

# 次期改修指示書P0-6: NODE_ENV=production では REDIS_URL / ENCRYPTION_KEY /
# LINE_CHANNEL_ID (このファイル上部で既に定義済み) が未設定の場合、API起動時に
# assertProductionEnvSafe() が例外を投げて起動を中止する
# (apps/api/src/common/assert-production-env.ts参照)。

# Feature Flag (開発ガイドライン13章): すべて既定でfalse。"true" を設定した場合のみ有効になる。
# 代理店システム等の外部連携が実装されるまでは、いずれもONにしないこと。
ENABLE_PLATFORM_USER_ID=false
ENABLE_WALLET_REFERRAL_TOKEN=false
ENABLE_AGENCY_REFERRAL_SYNC=false
ENABLE_AGENCY_SYNC_RETRY=false
ENABLE_WALLET_REGISTRATION_BONUS=false
ENABLE_EXTERNAL_REWARD_TYPES=false
ENABLE_ONCHAIN_MIGRATION=false
# 千ノ国 全体統合 共通実装契約 (2026-07-21) の POST /api/integrations/events。
# 修正・試験が完了するまでOFFを維持すること (次期改修指示書2章)。
ENABLE_COMMON_EVENT_INBOX=false
# NFTコレクション実装指示書。戦国マーケットとの結合試験が完了するまでOFFを維持すること。
ENABLE_DIGITAL_COLLECTION=false
ENABLE_COLLECTIBLE_ENTITLEMENT_INBOX=false
