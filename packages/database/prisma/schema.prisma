// =====================================================================
// 9. 外部連携基盤 (開発ガイドライン10章): Transactional Outbox
// =====================================================================

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

/// Transactional Outbox (開発ガイドライン10.1章)。業務トランザクション (OVEアカウント作成・
/// 紹介状態更新など) と同一DBトランザクションでイベントを確定することで、外部システムへの
/// 連携ジョブ登録前に障害が起きても連携予定データを失わないようにする。送信自体は非同期の
/// ワーカー (OutboxService.processPendingEvents) が指数バックオフで再送する。
model IntegrationOutbox {
  id                 String       @id
  eventType          String       @map("event_type")
  aggregateType      String       @map("aggregate_type")
  aggregateId        String       @map("aggregate_id")
  destinationService String       @map("destination_service")
  payload            Json
  idempotencyKey     String       @unique @map("idempotency_key")
  status             OutboxStatus @default(PENDING)
  attemptCount       Int          @default(0) @map("attempt_count")
  availableAt        DateTime     @default(now()) @map("available_at")
  lockedAt           DateTime?    @map("locked_at")
  lastErrorCode      String?      @map("last_error_code")
  lastErrorMessage   String?      @map("last_error_message")
  createdAt          DateTime     @default(now()) @map("created_at")
  processedAt        DateTime?    @map("processed_at")

  @@index([status, availableAt])
  @@index([destinationService])
  @@map("integration_outbox")
}

// =====================================================================
// 12. 戦国経済圏代理店システム(sengoku-ai.com)外部連携
// (外部連携API仕様書 v3.6.71、開発ガイドライン v1.0)
//
// 開発ガイドライン4.3章/9.1章の方針に従い、専用テーブルは持たず既存の
// ServiceIntegration(ServiceCode.AGENCY_SYSTEM) + AccountLink を再利用する。
// 認証ロジックのみ、sengoku-ai.com側がHMAC署名に対応していないため簡易版
// (AgencyApiKeyGuard) を別途用意している。
// =====================================================================

// =====================================================================
// 13. 代理店紹介トークン受け入れ・登録特典 (実装指示書 v1.0)
//
// 代理店紹介URL (/invite/{token}) 経由の新規登録者について、紹介関係の記録と
// 初回登録特典3,000 OVEの保留・確定を管理する。12章のAGENCY_SYSTEM連携とは別に、
// 実装指示書10章の方針通り専用テーブルを持つ (紹介関係はservice_integrations等の
// 既存の外部サービス連携の仕組みでは表現できないため)。
// =====================================================================

/// 紹介トークンの受付から登録・外部確認までの状態。単純な真偽値では管理しない
/// (実装指示書7章)。
enum WalletReferralStatus {
  /// /invite/{token} で受け付け、登録セッションCookieを発行した直後 (登録未完了)。
  CAPTURED
  /// 新規登録が完了し、代理店システムからの確認待ち。
  PENDING
  /// 代理店システム側で有効な紹介関係と確認済み。
  CONFIRMED
  /// トークン無効・期限切れ・対象外等で否認。
  REJECTED
  /// 管理者が根拠を確認して手動確定 (Phase 3で追加する管理操作の対象)。
  MANUALLY_CONFIRMED
  /// 誤登録等により管理者が取消。
  CANCELLED
  /// 通信・システムエラーで処理継続不能。
  ERROR
  /// 登録に使われないままセッション有効期限が切れた。
  EXPIRED
}

enum WalletReferralBenefitStatus {
  /// 紹介確認または本人条件の確認待ち。
  PENDING
  /// 3,000 OVEを確定付与済み。
  CONFIRMED
  /// 条件不成立により未付与。
  REJECTED
  /// 一度付与した後に取消済み。
  REVOKED
}

/// 紹介トークンの受付 (登録前の一時セッション) と、登録後の紹介関係を
/// 同一テーブルで管理する (実装指示書5.5章の「紹介トークン」「紹介セッション」を
/// status/walletUserIdの有無で表現し、別テーブルへ分割しない)。
model WalletReferral {
  id           String  @id
  /// 登録完了までnull。登録完了時にOVEアカウントIDを設定する。
  walletUserId String? @map("wallet_user_id")
  /// 将来 `ENABLE_PLATFORM_USER_ID` が有効になった場合の共通ID。Phase 1では未設定。
  commonUserId String? @map("common_user_id")

  /// /invite/{token} のCookie発行に使う不透明トークンのハッシュ (このテーブル自体を
  /// セッションストアとして使う)。SHA-256 (`sha256Hex`、セッショントークンと同じ方式)。
  sessionTokenHash       String @unique @map("session_token_hash")
  /// 代理店システムが発行した紹介トークンの本体。Phase 2の外部送信時に平文が必要なため
  /// 可逆暗号化 (`encryptSecret`) で保存する。ログには絶対に出さない。
  referralTokenEncrypted String @map("referral_token_encrypted")
  /// 検索用の一方向ハッシュ。
  referralTokenHash      String @map("referral_token_hash")

  /// Phase 2で代理店システムから確認結果を受け取った際に設定される代理店ID。
  /// 代理店のランク・階層情報自体はウォレット側で永続管理しない
  /// (開発ガイドライン5.1章・18章「代理店ランクのウォレット内管理」は対象外)。
  agencyId String? @map("agency_id")

  /// 千ノ国 全体統合 共通実装契約 5章。代理店システムの`POST /api/referrals/capture`
  /// からの応答で得られる正式トークン (`rt_...`)。Phase 1のinvite tokenそのままではなく
  /// canonical化された値。Outbox送信同様、平文が必要な再送に備え可逆暗号化で保存する。
  canonicalReferralTokenEncrypted String? @map("canonical_referral_token_encrypted")
  /// 同5章。`capture`応答の`referral_session_key` (`rs_...`)。`confirm`呼び出し時に必要。
  referralSessionKey              String? @map("referral_session_key")
  /// 代理店システムへのcapture/confirm呼び出し失敗によるリトライ回数
  /// (契約7章`sync_attempt_count`相当)。失敗理由自体は既存の
  /// lastErrorCode/lastErrorMessageに保存する。
  agencySyncAttemptCount          Int     @default(0) @map("agency_sync_attempt_count")

  status WalletReferralStatus @default(CAPTURED)
  /// `invite_url` (通常フロー) / `admin` (管理者による後付け) / `migration`。
  source String               @default("invite_url")

  capturedAt   DateTime  @default(now()) @map("captured_at")
  /// セッションの有効期限 (既定24時間、実装指示書2種の目安7日/24時間のうち短い方を採用)。
  expiresAt    DateTime  @map("expires_at")
  /// 登録に使われた日時 (このセッションはこれ以降再利用できない)。
  usedAt       DateTime? @map("used_at")
  registeredAt DateTime? @map("registered_at")
  confirmedAt  DateTime? @map("confirmed_at")
  rejectedAt   DateTime? @map("rejected_at")
  revokedAt    DateTime? @map("revoked_at")

  lastErrorCode    String? @map("last_error_code")
  lastErrorMessage String? @map("last_error_message")
  /// IP/UAは生値を保存せず、監査目的の一方向ハッシュのみ保存する (実装指示書16章)。
  createdIpHash    String? @map("created_ip_hash")
  userAgentHash    String? @map("user_agent_hash")
  reason           String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  account  OveAccount?             @relation(fields: [walletUserId], references: [id])
  benefits WalletReferralBenefit[]

  // walletUserIdがnullの行 (登録前セッション) は複数存在しうるが、登録完了後は
  // 1アカウントにつき有効な紹介関係は1件のみとする (実装指示書10.1章)。
  // Postgresのunique indexはNULLを複数許容するため、この制約で両立できる。
  @@unique([walletUserId])
  @@index([status])
  @@index([expiresAt])
  @@map("wallet_referrals")
}

model WalletReferralBenefit {
  id             String  @id
  walletUserId   String  @map("wallet_user_id")
  /// LINEユーザーIDの一方向ハッシュ (生値は保存しない、実装指示書9章条件5)。
  lineUserIdHash String? @map("line_user_id_hash")
  referralId     String  @map("referral_id")

  /// 今回は "REFERRAL_SIGNUP_BONUS" のみ。将来の特典種別追加を見越して文字列で持つ。
  benefitType String                      @default("REFERRAL_SIGNUP_BONUS") @map("benefit_type")
  /// 実際に付与する額。REFERRAL_SIGNUP_BONUS_AMOUNT設定を変更しても過去の記録は変わらない。
  amount      BigInt
  status      WalletReferralBenefitStatus @default(PENDING)

  /// 台帳への冪等キー (`REFERRAL_SIGNUP_BONUS:{walletUserId}`)。
  idempotencyKey      String  @unique @map("idempotency_key")
  ledgerTransactionId String? @map("ledger_transaction_id")

  confirmedAt DateTime? @map("confirmed_at")
  rejectedAt  DateTime? @map("rejected_at")
  revokedAt   DateTime? @map("revoked_at")
  reason      String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  referral WalletReferral @relation(fields: [referralId], references: [id])

  // 同一アカウント・同一LINEユーザーIDへの二重付与をDB制約でも防止する
  // (実装指示書9.1章)。lineUserIdHashがnullの行は複数存在しうるが問題ない
  // (LINE未連携の紹介ではそもそも特典を確定しないため)。
  @@unique([benefitType, walletUserId])
  @@unique([benefitType, lineUserIdHash])
  @@index([walletUserId])
  @@map("wallet_referral_benefits")
}

/// ウォレットホーム画面「お知らせ」で表示するお知らせ (管理画面から作成・削除する)。
model Notice {
  id          String           @id
  title       String
  message     String
  status      NoticeStatus     @default(PUBLISHED)
  /// IMPORTANTは一覧で強調表示する (docs/notices-read-tracking.md参照)。
  importance  NoticeImportance @default(NORMAL)
  /// 宛先。null = 全員向け (従来のお知らせ)。値がある場合はその利用者にだけ表示する。
  /// 失効予告のように本人にしか意味のない連絡を送るために追加した
  /// (docs/notices-read-tracking.md「個別通知」参照)。
  oveAccountId String?         @map("ove_account_id")
  publishedAt DateTime         @default(now()) @map("published_at")
  createdBy   String           @map("created_by")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  account OveAccount?  @relation(fields: [oveAccountId], references: [id])
  reads   NoticeRead[]

  @@index([status, publishedAt])
  /// 個別通知を宛先で引くための索引 (全員向けはnullなので対象外)。
  @@index([oveAccountId])
  @@map("notices")
}

/// お知らせの既読状態 (アカウント単位)。行が存在すれば既読、存在しなければ未読。
model NoticeRead {
  id           String   @id
  noticeId     String   @map("notice_id")
  oveAccountId String   @map("ove_account_id")
  readAt       DateTime @default(now()) @map("read_at")

  notice  Notice     @relation(fields: [noticeId], references: [id])
  account OveAccount @relation(fields: [oveAccountId], references: [id])

  @@unique([noticeId, oveAccountId])
  @@index([oveAccountId])
  @@map("notice_reads")
}

// =====================================================================
// 14. 千ノ国 全体統合 共通イベント受信 (共通実装契約 v1.0 6章): Inbox
//
// 代理店システム・ショッピング等、他システムから送信される共通イベント
// (common_user.resolved / common_user.merged / referral.confirmed /
// customer.assignment.changed / reward.granted / reward.reversed 等) の受信を
// 冪等に処理するためのInbox。9章のOutbox (IntegrationOutbox、送信専用) とは
// 逆方向。event_idごとに一意の行を持ち、同一event_id+同一本文ハッシュは
// 再処理せず前回の結果を返し (200)、本文ハッシュが異なれば処理せず409を返す
// (契約6.4章)。
// =====================================================================

enum InboundEventStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  DEAD
}

model InboundEvent {
  id               String             @id
  /// 送信元で一意に固定される値 (契約6.3章の`event_id`)。単体では一意ではない
  /// (PR-W3-a-2で`source_system_key + event_id`の複合UNIQUEへ変更。異なるMarket等が
  /// 偶然同じevent_id値を送ってくる可能性を排除できないため)。
  eventId          String             @map("event_id")
  eventType        String             @map("event_type")
  eventVersion     String             @map("event_version")
  sourceSystemKey  String             @map("source_system_key")
  /// 受信した本文全体 (契約6.3章の共通本文)。処理ハンドラはここから読む。
  payload          Json
  /// 本文の一方向ハッシュ (SHA-256)。同一event_idの再送で本文が変わっていないか照合する。
  payloadHash      String             @map("payload_hash")
  correlationId    String?            @map("correlation_id")
  status           InboundEventStatus @default(PENDING)
  attemptCount     Int                @default(0) @map("attempt_count")
  nextRetryAt      DateTime?          @map("next_retry_at")
  lastErrorCode    String?            @map("last_error_code")
  lastErrorMessage String?            @map("last_error_message")
  /// 処理成功時に返したレスポンス本文。同一event_id+同一ハッシュの再送時にそのまま返す。
  resultPayload    Json?              @map("result_payload")
  processedAt      DateTime?          @map("processed_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  /// PR-W3-a-2: 冪等キーの本来あるべき形。source_system_key単位でevent_idの一意性を見る。
  @@unique([sourceSystemKey, eventId])
  @@index([status, nextRetryAt])
  @@index([sourceSystemKey, eventType])
  @@map("inbound_events")
}

enum CommonEventSigningKeyStatus {
  ACTIVE
  REVOKED
}

/// 共通イベント契約6.1章の`X-SenNoKuni-Key-Id`に対応する送信元別HMAC署名鍵。
/// 送信元システム (代理店システム等) ごと・鍵ID単位で複数保持し、ローテーション時は
/// 新しい行を追加してから旧行をREVOKEDにする (即時失効させない移行を可能にする)。
model CommonEventSigningKey {
  id                String                      @id
  keyId             String                      @unique @map("key_id")
  sourceSystemKey   String                      @map("source_system_key")
  /// HMAC検証には平文シークレットの復元が必要なため、ServiceIntegrationと同様に
  /// 一方向ハッシュではなくAES-256-GCM可逆暗号化で保存する。
  secretEncrypted   String                      @map("secret_encrypted")
  /// この鍵で送信を許可するevent_type (例: "common_user.resolved"、末尾".*"でprefix一致、
  /// 例: "order.*")。既定は空配列=何も許可しない(secure-by-default、次期改修指示書P0-3)。
  /// 鍵発行時に明示的に許可対象を指定する必要がある。
  allowedEventTypes String[]                    @default([]) @map("allowed_event_types")
  status            CommonEventSigningKeyStatus @default(ACTIVE)
  createdAt         DateTime                    @default(now()) @map("created_at")
  updatedAt         DateTime                    @updatedAt @map("updated_at")
  revokedAt         DateTime?                   @map("revoked_at")

  @@index([sourceSystemKey, status])
  @@map("common_event_signing_keys")
}

// =====================================================================
// 15. NFTコレクション (千ノ国ウォレット NFTコレクション実装指示書)
//
// 戦国マーケットで購入したデジタルカードを画像カードとして保管・表示する。
// 将来のブロックチェーンMintに備えたデータ構造を持つが、MVPでは書き込まない
// (`CollectibleHolding`の`network`/`chainId`/`contractAddress`/`tokenId`/
// `transactionHash`/`ownerAddress`/`mintedAt`/`metadataUri`は将来用nullable項目)。
// =====================================================================

enum CollectibleAssetStatus {
  ACTIVE
  ARCHIVED
}

enum CollectibleHoldingStatus {
  ACTIVE
  REVOKED
  /// 以下はMVPでは到達しない将来のMint状態遷移用 (指示書5.2章)。
  MINT_READY
  MINTING
  ONCHAIN
  TRANSFERRED
  BURNED
  ERROR
}

/// カードのマスターデータ。同じ`assetCode`を複数ユーザーが保有しうる
/// (`CollectibleHolding`側で保有者ごとに行を分ける)。
model CollectibleAsset {
  id           String                 @id
  assetCode    String                 @unique @map("asset_code")
  productCode  String?                @map("product_code")
  name         String
  description  String?
  imageUrl     String                 @map("image_url")
  thumbnailUrl String?                @map("thumbnail_url")
  /// 画像の一方向ハッシュ (指示書17章「画像セキュリティ」、差し替え検知用)。
  imageHash    String?                @map("image_hash")
  rarity       String?
  category     String?
  editionSize  Int?                   @map("edition_size")
  metadata     Json?
  status       CollectibleAssetStatus @default(ACTIVE)
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")

  holdings CollectibleHolding[]

  @@index([productCode])
  @@map("collectible_assets")
}

/// 1ユーザーの1カード保有権 (entitlement) を表す。`entitlementId`が戦国マーケット側の
/// `NftIssue.id`と1:1で対応し、`entitlement.granted`/`entitlement.revoked`の冪等キーになる。
model CollectibleHolding {
  id                       String                   @id
  oveAccountId             String                   @map("ove_account_id")
  collectibleAssetId       String                   @map("collectible_asset_id")
  /// 戦国マーケット側の`NftIssue.id` (指示書5.2章)。同一entitlementで複数Holdingを
  /// 作らないためのUNIQUE制約。
  entitlementId            String                   @unique @map("entitlement_id")
  sourceSystemKey          String                   @map("source_system_key")
  orderId                  String?                  @map("order_id")
  orderItemId              String?                  @map("order_item_id")
  acquiredAt               DateTime                 @map("acquired_at")
  status                   CollectibleHoldingStatus @default(ACTIVE)
  revokedAt                DateTime?                @map("revoked_at")
  /// 外部システム(Market)からの自由記述。監査・調査目的でのみ保持し、通常の管理画面/
  /// ユーザー画面へは表示しない (PR-W3-a: `revokeReasonCode`のマッピング済み文言を表示する)。
  revokeReason             String?                  @map("revoke_reason")
  /// PR-W3-a: 構造化された取消理由コード (例: "full_refund")。表示はこの値をキーに
  /// 固定文言表へマッピングする。未知の値でも取消処理自体は継続する。
  revokeReasonCode         String?                  @map("revoke_reason_code")
  /// PR-W3-a: 取消を行った認証済みsource_system_key。付与時のsourceSystemKeyと通常は一致するが
  /// (自動取消はsource一致を要求する)、管理画面からの手動取消等と区別できるよう独立して保持する。
  revokedBySourceSystemKey String?                  @map("revoked_by_source_system_key")
  /// PR-W3-a: 取消の起点になったevent_id。再送で値が変わらないことをテストで確認する。
  revokedByEventId         String?                  @map("revoked_by_event_id")
  revokedCorrelationId     String?                  @map("revoked_correlation_id")
  /// PR-W3-a: Market側event本文のoccurred_at (Wallet側処理時刻のrevokedAtとは別軸)。
  revokedOccurredAt        DateTime?                @map("revoked_occurred_at")
  /// 購入時スナップショット (指示書9章「Asset更新方針」推奨: CollectibleAssetが
  /// マスター、こちらは取得時点の名称・画像URL等を保持する)。P1-3で専用列を追加した後も
  /// 破壊的変更禁止のため残す (専用列導入以前に作られた行の非公式スナップショットとして
  /// 引き続き利用可能)。
  metadata                 Json?

  /// PR#2最終修正 P1-3: 付与時点で固定する表示用スナップショット。CollectibleAssetの
  /// 後続編集を、既に付与済みのHoldingの表示へ反映させないための専用列
  /// (metadataの非公式Jsonブロブと違い型付き・検索可能)。すべてnullable
  /// (指示書10章「破壊的変更禁止」、既存行はCollectibleAssetからbackfill可能)。
  displayNameSnapshot  String? @map("display_name_snapshot")
  descriptionSnapshot  String? @map("description_snapshot")
  imageUrlSnapshot     String? @map("image_url_snapshot")
  thumbnailUrlSnapshot String? @map("thumbnail_url_snapshot")
  imageHashSnapshot    String? @map("image_hash_snapshot")
  raritySnapshot       String? @map("rarity_snapshot")
  /// PR#2最終修正 P1-4: 戦国マーケットの`metadata.serial_number`をそのまま不変値として
  /// 保存する ("0034"のような桁固定表記もあるため文字列)。未送信ならnull (画面では非表示)。
  /// 動的COUNTによる算出 (旧`countAcquiredBeforeOrAt`) は他Holdingの増減で値が変動する
  /// ため廃止した。
  serialNumber         String? @map("serial_number")

  // --- 将来Mint項目 (指示書18章)。MVPでは書き込まない。すべてnullableのまま。 ---
  network         String?
  chainId         String?   @map("chain_id")
  contractAddress String?   @map("contract_address")
  tokenId         String?   @map("token_id")
  transactionHash String?   @map("transaction_hash")
  ownerAddress    String?   @map("owner_address")
  mintedAt        DateTime? @map("minted_at")
  metadataUri     String?   @map("metadata_uri")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  account OveAccount       @relation(fields: [oveAccountId], references: [id])
  asset   CollectibleAsset @relation(fields: [collectibleAssetId], references: [id])

  @@index([oveAccountId, status])
  @@index([orderId])
  @@index([orderItemId])
  @@index([contractAddress, tokenId])
  @@map("collectible_holdings")
}

/// NFTカードClaim導線実装指示書4章。戦国マーケットの受取URL(`/claim/{token}`)が
/// 発行する生Claim Tokenをブラウザへ長期保存させないための、サーバー側セッション。
/// `id`自体が不透明なランダム値であり、Cookie値・安全なReturn Path
/// (`/claim/{id}`)の両方として使う (WalletReferralの`session_token_hash`と違い
/// 2層に分けていないのは、指示書4章が明記する4項目 (claim_session_id/token_hash/
/// expires_at/created_at) に沿った最小構成のため)。生Claim Token自体は
/// `WalletReferral.referralTokenEncrypted`と同じ理由で可逆暗号化して保持する
/// (Market Confirm API呼び出し時に平文が必要)。
model ClaimSession {
  id             String   @id
  /// 同じ生Tokenで複数回訪問されても新規行を作らないための検索用ハッシュ。
  tokenHash      String   @unique @map("token_hash")
  tokenEncrypted String   @map("token_encrypted")
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("claim_sessions")
}

/// 千ノ国NFTマーケット契約v2指示書23〜24章。at-least-once配送・順序保証なしの契約下では
/// `entitlement.revoked`が対応する`entitlement.granted`より先に届くことがある。その場合
/// CollectibleHoldingを作成できない(所有者・Asset情報が未着のため)ため、代わりにこの行を
/// 記録し、後から届く`entitlement.granted`がACTIVE Holdingを作らないようにする
/// (指示書25章「revoked → granted → ACTIVEにならない」)。
model CollectibleEntitlementTombstone {
  id              String    @id
  /// 同じentitlement_idの重複作成を防ぐ (revoke再送時は既存行をそのまま使う)。
  entitlementId   String    @unique @map("entitlement_id")
  sourceSystemKey String    @map("source_system_key")
  eventId         String    @map("event_id")
  reason          String
  /// PR-W3-a: 構造化された取消理由コード。CollectibleHolding.revokeReasonCodeと同じ意味。
  reasonCode      String?   @map("reason_code")
  correlationId   String?   @map("correlation_id")
  /// PR-W3-a: Market側event本文のoccurred_at (既存revokedAtはTombstone作成時刻)。
  occurredAt      DateTime? @map("occurred_at")
  revokedAt       DateTime  @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@map("collectible_entitlement_tombstones")
}
