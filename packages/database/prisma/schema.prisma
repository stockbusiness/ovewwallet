generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================================
// Enums
// =====================================================================

enum AccountStatus {
  PENDING
  ACTIVE
  RESTRICTED
  REVIEWING
  LOCKED
  CLOSED
  MERGED
}

enum IdentityType {
  LINE
  EMAIL
  PHONE
  PASSKEY
  GOOGLE
  APPLE
  BLOCKCHAIN_WALLET
  /// 既存ユーザー移行 (指示書15章) で旧システムのユーザーIDを紐付けるための識別子種別。
  LEGACY_SYSTEM
  /// 戦国経済圏代理店システム(sengoku-ai.com)のSSO(JWT/JWKS)でログインしたユーザー。
  SENGOKU_AGENCY
}

enum IdentityStatus {
  ACTIVE
  REVOKED
}

enum NoticeStatus {
  /// ユーザー向けウォレット画面に表示される
  PUBLISHED
  /// 管理画面でのみ確認できる下書き状態
  DRAFT
  /// 表示終了 (削除はせず非表示にする)
  ARCHIVED
}

enum NoticeImportance {
  NORMAL
  IMPORTANT
}

enum ServiceCode {
  SENGOKU_PASSPORT
  AIART
  SENGOKU_GACHA
  SENGOKU_EC
  NFT_MARKET
  SENGOKU_METAVERSE
  EVENT_SYSTEM
  /// 戦国経済圏代理店システム(sengoku-ai.com、外部連携API仕様書v3.6.71)。
  /// x-api-key/Bearerのみの単純な鍵認証で、HMAC署名検証は行わない
  /// (開発ガイドライン9.1章: 新しい認証方式を乱立させず既存のservice_integrationsを
  /// 再利用する方針だが、相手システムがHMAC署名に対応していないため認証ロジック自体は
  /// 簡易版を別途用意している。`AgencyApiKeyGuard`参照)。
  AGENCY_SYSTEM
}

enum ServiceIntegrationStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum AccountLinkStatus {
  /// OVEアカウントとまだ紐付いていない、外部側からの同期のみ受信した状態
  /// (開発ガイドライン5.5章の"SYNC_PENDING"相当)。
  PENDING
  ACTIVE
  REVOKED
}

enum WalletStatus {
  ACTIVE
  RESTRICTED
  LOCKED
  REVIEWING
  MIGRATING
  MIGRATED
  CLOSED
  MERGED
}

enum TransactionDirection {
  CREDIT
  DEBIT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  HELD
  FAILED
  REVERSED
  MIGRATING
  MIGRATED
}

enum TransactionType {
  REGISTRATION_BONUS
  AIART_ATTENDANCE
  /// 戦国EC(戦国楽市楽座、ServiceCode.SENGOKU_EC)の購入特典ポイント付与。
  /// reward_rules.rule_code = "SENGOKU_EC_PURCHASE_REWARD" と対応させる
  /// (apps/api/src/rewards/rewards.service.ts の RULE_CODE_BY_TRANSACTION_TYPE)。
  SENGOKU_EC_PURCHASE
  /// 千ノ国 全体統合 共通実装契約 6.2章の`reward.granted`イベント経由のOVE付与
  /// (共通イベントInbox、`apps/api/src/common-events/`)。既存の
  /// `POST /api/v1/rewards/grant` (X-OVE-*認証・ServiceIntegration経由) とは
  /// 受信経路が異なるため区別する。
  COMMON_EVENT_REWARD
  /// 千ノ国パスポート「はじまりの旅」学習ミッション専用の特典付与。
  /// reward_rules.rule_code = "SENGOKU_LEARNING_JOURNEY_REWARD" と対応させる
  /// (apps/api/src/rewards/rewards.service.ts の RULE_CODE_BY_TRANSACTION_TYPE)。
  /// 他のイベント報酬 (EVENT_REWARD等) と区別するために新設。
  LEARNING_JOURNEY_REWARD
  EVENT_REWARD
  CAMPAIGN_REWARD
  REFERRAL_REWARD
  PURCHASE_REWARD
  GACHA_REWARD
  DAILY_LOGIN_BONUS
  ADMIN_GRANT
  ADMIN_DEDUCTION
  OPENING_BALANCE
  GACHA_TICKET_EXCHANGE
  COUPON_EXCHANGE
  ITEM_EXCHANGE
  HOLD
  RELEASE
  REVERSAL
  RECOVERY
  ACCOUNT_MERGE_IN
  ACCOUNT_MERGE_OUT
  BLOCKCHAIN_MIGRATION
  MIGRATION_REVERSAL
  EXPIRATION
}

enum CreatedByType {
  USER
  ADMIN
  SYSTEM
  EXTERNAL_SERVICE
}

enum ApprovalType {
  AUTOMATIC
  MANUAL
}

enum RewardRuleStatus {
  ACTIVE
  INACTIVE
  SCHEDULED
  ENDED
}

enum WalletHoldStatus {
  HELD
  RELEASED
}

enum AuditResult {
  SUCCESS
  FAILURE
}

enum AdminRole {
  SUPER_ADMIN
  OVE_OPERATOR
  INTEGRATION_ADMIN
  EVENT_OPERATOR
  AUDITOR
  VIEWER
}

enum AdminUserStatus {
  ACTIVE
  SUSPENDED
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalRequestType {
  HIGH_VALUE_GRANT
  HIGH_VALUE_DEDUCTION
  ACCOUNT_MERGE
  MIGRATION_EXECUTION
  EXTERNAL_WALLET_CHANGE
  BLOCKCHAIN_MIGRATION
  SERVICE_LIMIT_CHANGE
}

enum BlockchainMigrationStatus {
  PENDING
  APPROVED
  COMPLETED
  FAILED
}

enum BulkGrantBatchStatus {
  UPLOADED
  PREVIEWED
  EXECUTING
  COMPLETED
  FAILED
}

enum MigrationBatchStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

/// 表示用コード (OVE-ACC-00001234 / OVE-WLT-00001234 等) を採番するためのカウンタ。
/// UPDATE ... RETURNING の単一ステートメントで原子的にインクリメントする。
model CodeCounter {
  id        String @id
  nextValue BigInt @default(1) @map("next_value")

  @@map("code_counters")
}

// =====================================================================
// 2. アカウント・認証
// =====================================================================

model OveAccount {
  id                           String        @id
  accountCode                  String        @unique @map("account_code")
  status                       AccountStatus @default(PENDING)
  displayName                  String?       @map("display_name")
  primaryEmail                 String?       @map("primary_email")
  primaryPhone                 String?       @map("primary_phone")
  verificationLevel            Int           @default(0) @map("verification_level")
  mergedIntoAccountId          String?       @map("merged_into_account_id")
  /// OVE利用規約に同意した日時。アカウント作成時に必須で記録する
  /// (この機能追加前に作成されたアカウントは null になりうる)。
  termsAgreedAt                DateTime?     @map("terms_agreed_at")
  /// 同意した利用規約のバージョン (例: "1.0")。
  termsVersion                 String?       @map("terms_version")
  /// 代理店システム内共通顧客HUBが発行するcommon_user_id (外部開発者向け連携
  /// ガイド9章)。ENABLE_PLATFORM_USER_ID有効時、新規アカウント作成後にベスト
  /// エフォートで解決・保存する。解決前の既存アカウント・呼び出し失敗時はnull。
  /// UNIQUE制約は付けない (既存の複数アカウントが同じcommon_user_idを保持する
  /// 状態を「あり得ない」と扱わず、検出して要レビューとして扱う既存の防御的設計
  /// (`CommonEventAccountResolver`・P0-5回帰テスト) と両立させるため)。
  /// 追加整合性対策P0-1: 異なる2アカウントへの同時設定競合(TOCTOU)は、DB制約
  /// ではなくPostgreSQL advisory lock (`CommonUserLinkingUseCase`が
  /// `pg_advisory_xact_lock`でcommon_user_id単位の書き込みを直列化) で防ぐ。
  commonUserId                 String?       @map("common_user_id")
  commonUserLinkedAt           DateTime?     @map("common_user_linked_at")
  /// 千ノ国 全体統合 共通実装契約 4.2章。初回登録を発生させた紹介代理店の
  /// agents.agent_code。原則ロックし、一度設定したら上書きしない
  /// (アプリケーション層で保護、`CommonEventHandlersService`参照)。
  registrationReferrerAgencyId String?       @map("registration_referrer_agency_id")
  /// 同4.2章。現在の顧客担当代理店のagent_code。`customer.assignment.changed`
  /// イベント受信のたびに更新される (運用上変更可能、変更履歴はAuditLogに残す)。
  assignedAgencyId             String?       @map("assigned_agency_id")
  createdAt                    DateTime      @default(now()) @map("created_at")
  updatedAt                    DateTime      @updatedAt @map("updated_at")
  closedAt                     DateTime?     @map("closed_at")

  mergedIntoAccount OveAccount?  @relation("AccountMerge", fields: [mergedIntoAccountId], references: [id])
  mergedAccounts    OveAccount[] @relation("AccountMerge")

  identities          AccountIdentity[]
  links               AccountLink[]
  wallet              Wallet?
  sessions            UserSession[]
  walletReferrals     WalletReferral[]
  noticeReads         NoticeRead[]
  /// 宛先がこのアカウントの個別通知 (全員向けのお知らせはここに含まれない)。
  notices             Notice[]
  dailyBonusClaims    DailyBonusClaim[]
  collectibleHoldings CollectibleHolding[]

  @@index([commonUserId])
  @@map("ove_accounts")
}

model AccountIdentity {
  id              String         @id
  oveAccountId    String         @map("ove_account_id")
  identityType    IdentityType   @map("identity_type")
  provider        String
  providerSubject String         @map("provider_subject")
  email           String?
  phone           String?
  verifiedAt      DateTime?      @map("verified_at")
  status          IdentityStatus @default(ACTIVE)
  metadata        Json?
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  account OveAccount @relation(fields: [oveAccountId], references: [id])

  @@unique([provider, providerSubject])
  @@index([oveAccountId])
  @@map("account_identities")
}

model ServiceIntegration {
  id                     String                   @id
  serviceCode            ServiceCode              @unique @map("service_code")
  serviceName            String                   @map("service_name")
  apiKeyHash             String                   @map("api_key_hash")
  /// HMAC署名検証には平文シークレットの復元が必要なため、一方向ハッシュではなく
  /// ENCRYPTION_KEY による可逆暗号化 (AES-256-GCM) で保存する。
  signingSecretEncrypted String                   @map("signing_secret_encrypted")
  allowedIps             String[]                 @map("allowed_ips")
  dailyAmountLimit       BigInt                   @map("daily_amount_limit")
  perRequestAmountLimit  BigInt                   @map("per_request_amount_limit")
  status                 ServiceIntegrationStatus @default(ACTIVE)
  /// PR-W2: このサービスが利用できる拡張API操作の一覧 (例: "wallet.balance.read.common-user")。
  /// 既定は空配列=何も許可しない (secure-by-default、common_event_signing_keys.allowed_event_types
  /// と同じパターン)。付与は管理者が個別に行う (docs/runbooks/grant-service-scope.md参照)。
  allowedScopes          String[]                 @default([]) @map("allowed_scopes")
  lastAccessedAt         DateTime?                @map("last_accessed_at")
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")

  links      AccountLink[]
  accessLogs ApiAccessLog[]

  @@map("service_integrations")
}

/// 代理店システム内共通顧客HUB (外部開発者向け連携ガイド9章) への送信設定。
/// ServiceIntegrationは「他システムがウォレットへ送ってくる際」の鍵を保持するのに
/// 対し、これは逆方向 (ウォレットがsengoku-ai.comへ送信する際) の設定を持つ、
/// 単一行のみのシングルトン設定 (id は固定値 "default")。管理画面
/// (/common-user-hub-config) から編集する。
model CommonUserHubConfig {
  id              String   @id
  baseUrl         String   @map("base_url")
  /// 外部開発者向け連携ガイド2章の system_key。ウォレット自身の識別子。
  systemKey       String   @map("system_key")
  /// sengoku-ai.com発行の「AI受信用APIキー」(ガイド3.1章)。ENCRYPTION_KEYによる
  /// 可逆暗号化 (AES-256-GCM、ServiceIntegration.signingSecretEncryptedと同方式)。
  apiKeyEncrypted String?  @map("api_key_encrypted")
  /// 管理画面表示用のマスク済みプレビュー (例: "****abcd")。生値は含まない。
  apiKeyPreview   String?  @map("api_key_preview")
  updatedAt       DateTime @updatedAt @map("updated_at")
  updatedBy       String?  @map("updated_by")

  @@map("common_user_hub_config")
}

/// 外部サービスAPI (指示書11章) へのリクエスト記録。管理画面の
/// 「APIアクセスログ」画面 (指示書13章) で参照する。
model ApiAccessLog {
  id                   String   @id
  serviceIntegrationId String?  @map("service_integration_id")
  apiKeyPrefix         String?  @map("api_key_prefix")
  method               String
  path                 String
  statusCode           Int      @map("status_code")
  sourceIp             String?  @map("source_ip")
  requestId            String?  @map("request_id")
  errorMessage         String?  @map("error_message")
  createdAt            DateTime @default(now()) @map("created_at")

  serviceIntegration ServiceIntegration? @relation(fields: [serviceIntegrationId], references: [id])

  @@index([serviceIntegrationId])
  @@index([createdAt])
  @@map("api_access_logs")
}

model AccountLink {
  id                   String            @id
  /// OVEアカウントとまだ紐付いていない同期受信のみの状態 (PENDING) を表現するため
  /// nullableにしている (開発ガイドライン5.5章のSYNC_PENDING相当)。
  oveAccountId         String?           @map("ove_account_id")
  serviceIntegrationId String            @map("service_integration_id")
  externalUserId       String            @map("external_user_id")
  status               AccountLinkStatus @default(ACTIVE)
  linkMethod           String            @map("link_method")
  linkedAt             DateTime          @default(now()) @map("linked_at")
  verifiedAt           DateTime?         @map("verified_at")
  revokedAt            DateTime?         @map("revoked_at")
  metadata             Json?

  account            OveAccount?        @relation(fields: [oveAccountId], references: [id])
  serviceIntegration ServiceIntegration @relation(fields: [serviceIntegrationId], references: [id])

  @@unique([serviceIntegrationId, externalUserId])
  @@index([oveAccountId])
  @@map("account_links")
}

model UserSession {
  id               String    @id
  oveAccountId     String    @map("ove_account_id")
  sessionTokenHash String    @unique @map("session_token_hash")
  deviceId         String?   @map("device_id")
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  issuedAt         DateTime  @default(now()) @map("issued_at")
  expiresAt        DateTime  @map("expires_at")
  lastUsedAt       DateTime? @map("last_used_at")
  revokedAt        DateTime? @map("revoked_at")
  revokeReason     String?   @map("revoke_reason")

  account OveAccount @relation(fields: [oveAccountId], references: [id])

  @@index([oveAccountId])
  /// データ保持ジョブが期限切れセッションを expires_at で抽出して削除するための索引。
  @@index([expiresAt])
  @@map("user_sessions")
}

model AdminUser {
  id                 String          @id
  adminCode          String          @unique @map("admin_code")
  email              String          @unique
  passwordHash       String          @map("password_hash")
  role               AdminRole
  status             AdminUserStatus @default(ACTIVE)
  displayName        String          @map("display_name")
  lastLoginAt        DateTime?       @map("last_login_at")
  /// TOTPシークレット (AES-256-GCMで可逆暗号化)。MFA未設定の間は null。
  mfaSecretEncrypted String?         @map("mfa_secret_encrypted")
  /// trueになるまではログイン時にMFAを要求しない (setup直後・enable確認前はfalseのまま)。
  mfaEnabled         Boolean         @default(false) @map("mfa_enabled")
  mfaEnrolledAt      DateTime?       @map("mfa_enrolled_at")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  @@map("admin_users")
}

// =====================================================================
// 3. ウォレット・台帳
// =====================================================================

model Wallet {
  id               String       @id
  oveAccountId     String       @unique @map("ove_account_id")
  walletCode       String       @unique @map("wallet_code")
  status           WalletStatus @default(ACTIVE)
  availableBalance BigInt       @default(0) @map("available_balance")
  pendingBalance   BigInt       @default(0) @map("pending_balance")
  heldBalance      BigInt       @default(0) @map("held_balance")
  recoveryBalance  BigInt       @default(0) @map("recovery_balance")
  lifetimeCredited BigInt       @default(0) @map("lifetime_credited")
  lifetimeDebited  BigInt       @default(0) @map("lifetime_debited")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  account      OveAccount            @relation(fields: [oveAccountId], references: [id])
  transactions OveTransaction[]
  holds        WalletHold[]
  migrations   BlockchainMigration[]
  creditLots   OveCreditLot[]

  @@map("wallets")
}

model OveTransaction {
  id                   String               @id
  walletId             String               @map("wallet_id")
  transactionCode      String               @unique @map("transaction_code")
  transactionType      TransactionType      @map("transaction_type")
  direction            TransactionDirection
  amount               BigInt
  status               TransactionStatus    @default(PENDING)
  balanceBefore        BigInt               @map("balance_before")
  balanceAfter         BigInt               @map("balance_after")
  displayName          String               @map("display_name")
  description          String?
  sourceService        String?              @map("source_service")
  sourceReferenceId    String?              @map("source_reference_id")
  relatedTransactionId String?              @map("related_transaction_id")
  idempotencyKey       String               @unique @map("idempotency_key")
  occurredAt           DateTime             @default(now()) @map("occurred_at")
  completedAt          DateTime?            @map("completed_at")
  createdByType        CreatedByType        @map("created_by_type")
  createdById          String?              @map("created_by_id")
  metadata             Json?
  createdAt            DateTime             @default(now()) @map("created_at")

  wallet             Wallet           @relation(fields: [walletId], references: [id])
  relatedTransaction OveTransaction?  @relation("TransactionReversal", fields: [relatedTransactionId], references: [id])
  reversals          OveTransaction[] @relation("TransactionReversal")
  creditLot          OveCreditLot?
  dailyBonusClaim    DailyBonusClaim?

  @@index([walletId])
  @@index([sourceService, sourceReferenceId])
  @@map("ove_transactions")
}

/// 継続ログイン(デイリー)ボーナス。1アカウント・1暦日につき1回のみ請求できる
/// (`@@unique([oveAccountId, claimedDate])`)。前日分の請求が無い状態で請求すると
/// streak_countは1にリセットされる。詳細: docs/daily-login-bonus.md
model DailyBonusClaim {
  id            String   @id
  oveAccountId  String   @map("ove_account_id")
  /// 暦日 (時刻情報を持たない、サーバーのローカル日付基準)。
  claimedDate   DateTime @map("claimed_date") @db.Date
  streakCount   Int      @map("streak_count")
  amount        BigInt
  transactionId String   @unique @map("transaction_id")
  createdAt     DateTime @default(now()) @map("created_at")

  account     OveAccount     @relation(fields: [oveAccountId], references: [id])
  transaction OveTransaction @relation(fields: [transactionId], references: [id])

  @@unique([oveAccountId, claimedDate])
  @@index([oveAccountId, claimedDate])
  @@map("daily_bonus_claims")
}

/// 有効期限付き獲得OVEの「ロット」。reward_rules.expiry_days が設定された
/// 付与ルール経由のCREDIT取引1件につき1行作成される (通常の管理者付与・
/// 移行インポート等は対象外)。DEBIT発生時にexpires_atが早い順(FIFO)で
/// remaining_amountを消費し、有効期限到来時に残っている分だけEXPIRATION
/// 取引として失効させる。詳細: docs/credit-expiry.md
model OveCreditLot {
  id              String    @id
  walletId        String    @map("wallet_id")
  transactionId   String    @unique @map("transaction_id")
  amount          BigInt
  remainingAmount BigInt    @map("remaining_amount")
  expiresAt       DateTime  @map("expires_at")
  expiredAt       DateTime? @map("expired_at")
  /// 元のCREDIT取引がREVERSALで取り消された場合にセットする (以後、消費・失効の対象外)
  voidedAt        DateTime? @map("voided_at")
  /// 失効予告のお知らせを作成した日時。同じロットについて毎日繰り返し通知しないための印。
  expiryNoticeSentAt DateTime? @map("expiry_notice_sent_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  wallet      Wallet         @relation(fields: [walletId], references: [id])
  transaction OveTransaction @relation(fields: [transactionId], references: [id])

  @@index([walletId, expiresAt])
  @@map("ove_credit_lots")
}

/// 月末時点のポイント負債 (発行済み未使用残高) のスナップショット。
/// 会計が「期首残高」を出すのに全期間の取引を遡らなくて済むようにするため。
/// 詳細: docs/point-liability.md
model PointLiabilitySnapshot {
  id String @id
  /// 対象月の末日 (JST基準の暦日)。月に1行。
  periodEnd DateTime @map("period_end") @db.Date
  /// 月末時点の負債残高。集計時点の実残高から、月末以降の増減を差し引いて求める
  /// (ジョブがいつ走っても同じ値になるようにするため)。
  totalBalance BigInt @map("total_balance")
  /// 算出に使った集計時点の実残高。監査時に計算を追えるように残す。
  balanceAtCapture BigInt @map("balance_at_capture")
  /// 差し引いた月末以降の純増減 (符号付き)。同上。
  movementAfterPeriod BigInt @map("movement_after_period")
  capturedAt DateTime @default(now()) @map("captured_at")

  @@unique([periodEnd])
  @@map("point_liability_snapshots")
}

model RewardRule {
  id                 String           @id
  ruleCode           String           @unique @map("rule_code")
  ruleName           String           @map("rule_name")
  sourceService      ServiceCode      @map("source_service")
  rewardAmount       BigInt           @map("reward_amount")
  perUserLimit       Int?             @map("per_user_limit")
  perEventLimit      Int?             @map("per_event_limit")
  monthlyCountLimit  Int?             @map("monthly_count_limit")
  monthlyAmountLimit BigInt?          @map("monthly_amount_limit")
  globalAmountLimit  BigInt?          @map("global_amount_limit")
  startsAt           DateTime?        @map("starts_at")
  endsAt             DateTime?        @map("ends_at")
  approvalType       ApprovalType     @default(AUTOMATIC) @map("approval_type")
  status             RewardRuleStatus @default(ACTIVE)
  displayName        String           @map("display_name")
  description        String?
  /// このルール経由で付与されたOVEが何日で失効するか。nullなら失効しない (既定)。
  expiryDays         Int?             @map("expiry_days")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  @@map("reward_rules")
}

model WalletHold {
  id         String           @id
  walletId   String           @map("wallet_id")
  amount     BigInt
  reason     String
  status     WalletHoldStatus @default(HELD)
  heldAt     DateTime         @default(now()) @map("held_at")
  releasedAt DateTime?        @map("released_at")
  createdBy  String           @map("created_by")
  createdAt  DateTime         @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@index([walletId])
  @@map("wallet_holds")
}

